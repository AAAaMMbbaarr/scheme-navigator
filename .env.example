# Copy to .env (which is git-ignored) and fill in ONE provider. Never commit real keys.
# Without a key the app still runs in English with a basic offline reader; other languages need the AI.
# NOTE: .env is read once when the server starts. Restart the server after editing it.

# --- Groq (OpenAI-compatible; free tier is fine for demos) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional: less hidden reasoning = faster/cheaper on gpt-oss models (low | medium | high)
# LLM_REASONING_EFFORT=low

# --- Anthropic (default when LLM_PROVIDER is unset) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Optional request timeout in seconds
# LLM_TIMEOUT=25

# Public-demo abuse protection: max analyses per client IP per minute (0 = off)
# RATE_LIMIT_PER_MINUTE=20
